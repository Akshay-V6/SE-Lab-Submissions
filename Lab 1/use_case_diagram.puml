@startuml
left to right direction
actor Customer
actor "Payment Gateway" as Gateway
actor Barista
actor "Store Admin" as Admin
rectangle "Coffee Ordering System" {
  usecase "UC-01 Select Coffee Type" as UC01
  usecase "UC-02 Select Drink Size" as UC02
  usecase "UC-03 Customize Drink" as UC03
  usecase "UC-04 Review Order" as UC04
  usecase "UC-05 Place and Pay for Order" as UC05
  usecase "UC-06 Receive Preparation Order" as UC06
  usecase "UC-07 Maintain Menu" as UC07
  usecase "UC-08 Calculate Total" as UC08
  usecase "UC-09 Process Payment" as UC09
}
Customer -- UC01
Customer -- UC02
Customer -- UC03
Customer -- UC04
Customer -- UC05
Gateway -- UC09
Barista -- UC06
Admin -- UC07
UC05 ..> UC08 : <<include>>
UC05 ..> UC09 : <<include>>
@enduml

@startuml
left to right direction
actor "Database Administrator" as DBA
actor "Backend Lead" as Lead
actor "Slow-query log source" as Logs
rectangle "Query Performance Profiler" {
 usecase "Ingest slow-query logs" as Ingest
 usecase "Parse SQL execution plans" as Parse
 usecase "Detect missing-index candidates" as Detect
 usecase "Rank candidates by impact" as Rank
 usecase "Review and record recommendation" as Review
 usecase "Generate weekly optimization digest" as Digest
 usecase "Export recommendation details" as Export
 Ingest ..> Parse : <<include>>
 Detect ..> Rank : <<include>>
 Digest ..> Rank : <<include>>
 Export ..> Review : <<extend>>
}
DBA -- Ingest
DBA -- Detect
DBA -- Review
DBA -- Rank
Lead -- Review
Lead -- Digest
Lead -- Export
Logs -- Ingest
@enduml
